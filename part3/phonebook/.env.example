# Copy to .env and fill in your own values. Never commit .env!
# Database user + cluster host (Atlas: Database Access user, not Atlas login).
MONGODB_USER=fullstack
MONGODB_CLUSTER=cluster0.example.mongodb.net
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/phonebookApp?retryWrites=true&w=majority
PORT=3001
